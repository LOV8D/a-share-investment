{
    default_sni {$APP_HOST}
}

{$APP_SITE} {
    tls internal
    encode zstd gzip
    import /etc/caddy/users.caddy
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }
    reverse_proxy app:8765
}
