{
  "calendar": {
    "columns": [
      "date"
    ],
    "description": "沪深交易日历，包含至少未来 10 个交易日",
    "required": true
  },
  "prices": {
    "columns": [
      "date",
      "symbol",
      "open",
      "high",
      "low",
      "close",
      "prev_close",
      "volume",
      "amount",
      "adj_factor",
      "upper_limit",
      "lower_limit",
      "suspended",
      "is_st",
      "market_cap",
      "float_market_cap",
      "turnover_rate",
      "industry",
      "min_order",
      "lot_step",
      "listed_days",
      "available_at"
    ],
    "description": "未复权日线、当日复权因子、历史交易状态和证券属性",
    "required": true
  },
  "universe": {
    "columns": [
      "date",
      "symbol",
      "weight",
      "known_at"
    ],
    "description": "逐日历史沪深300成分及权重，禁止用今天成分回填",
    "required": true
  },
  "fundamentals": {
    "columns": [
      "symbol",
      "report_period",
      "available_at",
      "revenue_ttm",
      "net_profit_ttm",
      "book_equity",
      "operating_cashflow_ttm",
      "total_assets",
      "total_liabilities",
      "roe",
      "gross_margin",
      "revenue_growth",
      "profit_growth"
    ],
    "description": "按实际可用时间保存的财务指标历史版本",
    "required": true
  },
  "benchmark": {
    "columns": [
      "date",
      "close",
      "total_return_close"
    ],
    "description": "沪深300价格指数及全收益指数",
    "required": true
  },
  "actions": {
    "columns": [
      "date",
      "symbol",
      "share_multiplier",
      "cash_per_share",
      "known_at"
    ],
    "description": "除权除息事件；无事件也提供带表头的空文件",
    "required": true
  },
  "documents": {
    "columns": [
      "document_id",
      "symbol",
      "source_type",
      "source_url",
      "published_at",
      "first_seen_at",
      "title",
      "text"
    ],
    "description": "公告、政策、新闻、论坛原文与首次抓取时间",
    "required": false
  },
  "events": {
    "columns": [
      "event_id",
      "document_id",
      "symbol",
      "category",
      "sentiment",
      "materiality",
      "confidence",
      "novelty",
      "source_type",
      "source_url",
      "published_at",
      "first_seen_at",
      "processed_at",
      "title",
      "evidence",
      "model",
      "prompt_version",
      "text_sha256"
    ],
    "description": "证据可追溯的 AI / 数据商事件标签",
    "required": false
  },
  "holdings": {
    "columns": [
      "symbol",
      "shares",
      "sellable_shares",
      "cost_price"
    ],
    "description": "信号日收盘账户持仓；模拟时默认为全现金",
    "required": false
  },
  "auction": {
    "columns": [
      "date",
      "symbol",
      "indicative_open",
      "upper_limit",
      "lower_limit",
      "suspended",
      "available_at"
    ],
    "description": "次日 09:25 集合竞价结果或指示价格，用于预检",
    "required": false
  },
  "fees": {
    "columns": [
      "start_date",
      "end_date",
      "sell_stamp_rate",
      "transfer_rate"
    ],
    "description": "分历史区间的卖出印花税和双边过户费",
    "required": true
  }
}